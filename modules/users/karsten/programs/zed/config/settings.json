{
  "proxy": "",
  "file_scan_exclusions": [],
  "show_edit_predictions": false,
  "edit_predictions": {
    "allow_data_collection": "no",
    "provider": "zed"
  },
  "language_models": {
    "mistral": {
      "available_models": [
        {
          "name": "glm-5-2",
          "display_name": "GLM 5.2",
          "max_tokens": 1048576,
          // "capabilities": { "tools": true, "images": false }
        }
      ]
    }
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "cli_default_open_behavior": "new_window",
  "collaboration_panel": {
    "dock": "left",
  },
  "agent": {
  },
  "git_panel": {
    "dock": "left",
  },
  "preview_tabs": {
    "enabled": false,
  },
  "status_bar": {
    "active_language_button": true,
  },
  "outline_panel": {
    "dock": "left",
    "folder_icons": true,
  },
  "project_panel": {
    "dock": "right",
    "button": true,
    "auto_fold_dirs": false,
    "hide_root": true,
    "folder_icons": false,
  },
  "vim_mode": false,
  "telemetry": {
    "metrics": false,
    "diagnostics": false,
  },
  "ensure_final_newline_on_save": false,
  "helix_mode": true,
  "ui_font_size": 16.0,
  "buffer_font_size": 16.0,
  "theme": {
    "mode": "dark",
    "light": "Light",
    "dark": "Gleam Dark",
  },
  "soft_wrap": "editor_width",
  "title_bar": {
    "show_onboarding_banner": false,
    "show_user_picture": false,
    "show_sign_in": false,
  },
  "disable_ai": false,
  "tab_bar": {
    "show_nav_history_buttons": false,
    "show_tab_bar_buttons": false,
  },
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false,
  },
  "lsp": {
    // "tinymist": {
    //   "settings": {
    //     "exportPdf": "onSave",
    //     "outputPath": "$root/$name",
    //   },
    // },
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always"
          }
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always"
          }
        }
      },
      "enable_lsp_tasks": true
    },
    "ruff": {
      "binary": {
        "path": "ruff",
        "arguments": ["server"],
      },
    },
  },
  "languages": {
    "CSharp": {
      "language_servers": ["csharp-ls", "!roslyn", "!omnisharp"]
    },
    "Elixir": {
      "language_servers": ["dexter", "elixir-ls"]
    },
    "HEEx": {
      "language_servers": ["dexter", "elixir-ls"]
    }
  },
  "buffer_font_family": "DejaVu Sans Mono",
  "ui_font_family": "DejaVu Sans",
}
